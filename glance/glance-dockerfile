FROM openstack-base

ENV DEBIAN_FRONTEND=noninteractive

# Install glance + tini in one layer
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        glance \
        tini \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Copy scripts
COPY glance/glance-setup.sh /usr/local/bin/
COPY glance/glance-entrypoint.sh /usr/local/bin/
COPY glance/glance-test-setup.sh /usr/local/bin/

# Make scripts executable
RUN chmod +x /usr/local/bin/*.sh

EXPOSE 9292

# tini becomes PID 1, then launches entrypoint
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/glance-entrypoint.sh"]

