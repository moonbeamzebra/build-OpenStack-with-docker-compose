FROM openstack-nova-base

RUN mkdir -p /etc/nova /var/lib/nova/tmp
RUN mkdir -p /var/lib/nova/instances
RUN chown -R nova:nova /var/lib/nova

# Copy config
COPY nova/nova.conf /etc/nova/nova.conf

RUN apt update && apt install -y \
    nova-compute \
    libvirt-daemon-system \
    libvirt-clients \
    qemu-system-arm \
    qemu-utils \
    bridge-utils \
    dnsmasq-base \
    && apt clean

# Following for cgroup v2 ; does not work
