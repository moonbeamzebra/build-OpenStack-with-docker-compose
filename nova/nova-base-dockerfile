FROM openstack-base

ENV DEBIAN_FRONTEND=noninteractive

# Base packages
RUN apt update && apt install -y \
    nova-api \
    nova-scheduler \
    nova-conductor \
    nova-novncproxy \
    nova-common \
    python3-openstackclient \
    tini \
    && apt clean

# Copy scripts
COPY rabbitmq/rabbitmq-conn-test.py /usr/local/bin/
