FROM openstack-nova-base

RUN mkdir -p /etc/nova /var/lib/nova/tmp

# Copy config
COPY nova/nova.conf /etc/nova/nova.conf

# Copy scripts
COPY nova/nova-entrypoint.sh /usr/local/bin/
COPY nova/nova-setup.sh /usr/local/bin/

# Make scripts executable
RUN chmod +x /usr/local/bin/*.sh

# Entrypoint
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/nova-entrypoint.sh"]
