FROM openstack-base

ENV DEBIAN_FRONTEND=noninteractive

# System packages
RUN apt-get update \
     && apt install -y keystone \
         memcached \
         python3-memcache \
      && apt-get clean \
      && rm -rf /var/lib/apt/lists/*

ADD wait_for_postgreSQL.sh wait_for_postgreSQL.sh
ADD keystone-setup.sh keystone-setup.sh
ADD keystone-run.sh keystone-run.sh

RUN chmod +x wait_for_postgreSQL.sh && chmod +x keystone-setup.sh && chmod +x keystone-run.sh

# Expose API Keystone port
EXPOSE 5000
# Expose memcached port
EXPOSE 11211

#CMD ./keystone-run.sh
CMD ./wait_for_postgreSQL.sh && ./keystone-setup.sh && ./keystone-run.sh
#CMD ["apachectl", "-D", "FOREGROUND"]