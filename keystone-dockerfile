FROM openstack-base

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        keystone \
        apache2 \
        libapache2-mod-wsgi-py3 \
        tini \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

COPY wait_for_postgreSQL.sh /usr/local/bin/
COPY keystone-setup.sh /usr/local/bin/
COPY keystone-entrypoint.sh /usr/local/bin/

RUN chmod +x /usr/local/bin/*.sh

EXPOSE 5000

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/keystone-entrypoint.sh"]
