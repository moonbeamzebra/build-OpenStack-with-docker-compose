FROM openstack-base

ENV DEBIAN_FRONTEND=noninteractive

# Base packages
RUN apt update && apt install -y \
    neutron-server \
    neutron-plugin-ml2 \
    neutron-linuxbridge-agent \
    neutron-l3-agent \
    neutron-dhcp-agent \
    neutron-metadata-agent \
    tini \
    && apt clean

RUN mkdir -p /var/lib/neutron/tmp
RUN chown neutron:neutron /var/lib/neutron/tmp

COPY neutron/neutron.conf /etc/neutron/neutron.conf
COPY neutron/ml2_conf.ini /etc/neutron/plugins/ml2/ml2_conf.ini
COPY neutron/linuxbridge_agent.ini /etc/neutron/plugins/ml2/linuxbridge_agent.ini
COPY neutron/dhcp_agent.ini /etc/neutron/dhcp_agent.ini
COPY neutron/l3_agent.ini /etc/neutron/l3_agent.ini
COPY neutron/metadata_agent.ini /etc/neutron/metadata_agent.ini

