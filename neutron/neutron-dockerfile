FROM neutron-base

# Copy scripts
COPY neutron/neutron-entrypoint.sh /usr/local/bin/
COPY neutron/neutron-setup.sh /usr/local/bin/
COPY neutron/neutron-test-setup.sh /usr/local/bin/
COPY rabbitmq/rabbitmq-conn-test.py /usr/local/bin/

# Make scripts executable
RUN chmod +x /usr/local/bin/*.sh

# Entrypoint
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/neutron-entrypoint.sh"]

